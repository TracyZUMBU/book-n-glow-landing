# Modèle des variables. Ne jamais y mettre de vraie valeur.
#
# Où vivent les vraies valeurs :
#   - .env.local             : Resend, emails, port (serveur Express, tous modes)
#   - .env.development.local : Supabase LOCAL (book-n-glow-backend, `supabase start`)
#                              + code admin. Lu par `npm run dev` uniquement.
#   - Netlify                : variables de production (build à chaque push sur main)
# Jamais de valeur de prod sur ta machine : `vite build` lit aussi .env et .env.local.

# Resend API Key
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email de contact pour recevoir les notifications
CONTACT_EMAIL=contact@booknglow.com

# Port du serveur Express (optionnel)
PORT=3001

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Obtenez votre ID sur https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase : en local, valeurs de `supabase status` dans book-n-glow-backend
VITE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
VITE_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Code d'accès pour la page Admin Providers
# Ce code est requis pour accéder à la page de gestion des prestataires
VITE_ADMIN_PROVIDERS_PAGE_ACCESS=your-secret-code-here
