# Resend API Key
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email de contact pour recevoir les notifications
CONTACT_EMAIL=contact@booknglow.com

# Port du serveur Express (optionnel)
PORT=3001

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Obtenez votre ID sur https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase Configuration
# Obtenez ces valeurs sur https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Alternative: vous pouvez aussi utiliser VITE_PUBLIC_SUPABASE_URL et VITE_PUBLIC_SUPABASE_ANON_KEY
